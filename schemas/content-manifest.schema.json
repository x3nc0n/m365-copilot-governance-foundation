{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m365-copilot-governance:content-manifest:1.0.0",
  "title": "M365 Copilot Governance Deployment Content Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [ "schemaVersion", "solutionVersion", "functions", "analytics", "workbooks" ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "solutionVersion": { "const": "0.1.2" },
    "functions": {
      "type": "array",
      "items": { "$ref": "#/$defs/function" }
    },
    "analytics": {
      "type": "array",
      "items": { "$ref": "#/$defs/analytic" }
    },
    "workbooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/workbook" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "duration": { "type": "string", "pattern": "^P(?!$).+" },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "resourceName", "displayName", "version", "source", "metadata", "sha256",
        "controlOwner", "category", "functionAlias", "functionParameters", "query"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "resourceName": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "source": { "$ref": "#/$defs/path" },
        "metadata": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" },
        "controlOwner": { "$ref": "#/$defs/id" },
        "category": { "$ref": "#/$defs/id" },
        "functionAlias": { "$ref": "#/$defs/id" },
        "functionParameters": { "type": "string" },
        "query": { "$ref": "#/$defs/id" }
      }
    },
    "fieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "identifier", "columnName" ],
      "properties": {
        "identifier": { "$ref": "#/$defs/id" },
        "columnName": { "$ref": "#/$defs/id" }
      }
    },
    "entityMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "entityType", "fieldMappings" ],
      "properties": {
        "entityType": { "$ref": "#/$defs/id" },
        "fieldMappings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fieldMapping" }
        }
      }
    },
    "groupingConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "reopenClosedIncident", "lookbackDuration", "matchingMethod",
        "groupByEntities", "groupByAlertDetails", "groupByCustomDetails"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "reopenClosedIncident": { "type": "boolean" },
        "lookbackDuration": { "$ref": "#/$defs/duration" },
        "matchingMethod": { "enum": [ "AllEntities", "AnyAlert", "Selected" ] },
        "groupByEntities": { "type": "array", "items": { "type": "string" } },
        "groupByAlertDetails": { "type": "array", "items": { "type": "string" } },
        "groupByCustomDetails": { "type": "array", "items": { "type": "string" } }
      }
    },
    "incidentConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "createIncident", "groupingConfiguration" ],
      "properties": {
        "createIncident": { "type": "boolean" },
        "groupingConfiguration": { "$ref": "#/$defs/groupingConfiguration" }
      }
    },
    "analytic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "resourceName", "displayName", "version", "source", "metadata", "sha256",
        "controlOwner", "description", "enabledByDefault", "severity", "query",
        "queryFrequency", "queryPeriod", "triggerOperator", "triggerThreshold",
        "suppressionDuration", "suppressionEnabled", "eventGroupingAggregationKind",
        "incidentConfiguration", "entityMappings", "alertDetailsOverride", "customDetails",
        "tactics", "techniques"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "resourceName": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "source": { "$ref": "#/$defs/path" },
        "metadata": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" },
        "controlOwner": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/id" },
        "enabledByDefault": { "type": "boolean" },
        "severity": { "enum": [ "Informational", "Low", "Medium", "High" ] },
        "query": { "$ref": "#/$defs/id" },
        "queryFrequency": { "$ref": "#/$defs/duration" },
        "queryPeriod": { "$ref": "#/$defs/duration" },
        "triggerOperator": { "enum": [ "GreaterThan", "LessThan", "Equal", "NotEqual" ] },
        "triggerThreshold": { "type": "integer", "minimum": 0 },
        "suppressionDuration": { "$ref": "#/$defs/duration" },
        "suppressionEnabled": { "type": "boolean" },
        "eventGroupingAggregationKind": { "enum": [ "SingleAlert", "AlertPerResult" ] },
        "incidentConfiguration": { "$ref": "#/$defs/incidentConfiguration" },
        "entityMappings": {
          "type": "array",
          "items": { "$ref": "#/$defs/entityMapping" }
        },
        "alertDetailsOverride": { "type": "object" },
        "customDetails": { "type": "object" },
        "tactics": { "type": "array", "items": { "type": "string" } },
        "techniques": { "type": "array", "items": { "type": "string" } }
      }
    },
    "workbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "resourceName", "displayName", "version", "source", "metadata", "sha256",
        "controlOwner", "description", "serializedData"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "resourceName": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "source": { "$ref": "#/$defs/path" },
        "metadata": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" },
        "controlOwner": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/id" },
        "serializedData": { "$ref": "#/$defs/id" }
      }
    }
  }
}
