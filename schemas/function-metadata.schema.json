{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m365-copilot-governance:function-metadata:1.0.0",
  "title": "M365 Copilot Governance Function Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "name",
    "displayName",
    "category",
    "functionAlias",
    "functionParameters",
    "authoritativeControlOwner",
    "nativePortalRoute",
    "dependencies",
    "freshness",
    "limitations",
    "missingSourceBehavior",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "Function" },
    "name": { "$ref": "#/$defs/name" },
    "displayName": { "$ref": "#/$defs/text" },
    "category": { "$ref": "#/$defs/text" },
    "functionAlias": { "$ref": "#/$defs/name" },
    "functionParameters": { "type": "string" },
    "authoritativeControlOwner": { "$ref": "#/$defs/controlOwner" },
    "nativePortalRoute": { "$ref": "#/$defs/portalRoute" },
    "dependencies": { "$ref": "#/$defs/dependencies" },
    "freshness": { "$ref": "#/$defs/freshness" },
    "limitations": { "$ref": "#/$defs/limitations" },
    "missingSourceBehavior": { "$ref": "#/$defs/missingSourceBehavior" },
    "privacy": { "$ref": "#/$defs/privacy" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "controlOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "sentinelRole" ],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "sentinelRole": { "$ref": "#/$defs/text" }
      }
    },
    "portalRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "label", "uri" ],
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "uri": { "type": "string", "pattern": "^https://" },
        "notes": { "$ref": "#/$defs/text" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "type", "name", "required" ],
        "properties": {
          "type": { "enum": [ "function", "parser", "table", "connector" ] },
          "name": { "$ref": "#/$defs/text" },
          "required": { "type": "boolean" },
          "owner": { "$ref": "#/$defs/text" }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "expected" ],
      "properties": {
        "expected": { "$ref": "#/$defs/text" },
        "defaultLookback": { "$ref": "#/$defs/text" },
        "evaluationWindow": { "$ref": "#/$defs/text" },
        "correlationWindow": { "$ref": "#/$defs/text" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/text" },
      "uniqueItems": true
    },
    "missingSourceBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "mode", "description" ],
      "properties": {
        "mode": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "promptOrResponseContent" ],
      "properties": {
        "promptOrResponseContent": { "$ref": "#/$defs/text" },
        "identityHandling": { "$ref": "#/$defs/text" },
        "usageAsMisconduct": { "$ref": "#/$defs/text" }
      }
    }
  }
}
