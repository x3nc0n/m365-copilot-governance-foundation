{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m365-copilot-governance:release-manifest:1.0.0",
  "title": "M365 Copilot Governance Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [ "schemaVersion", "solutionVersion", "contentManifestSha256", "artifacts" ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "solutionVersion": { "const": "0.1.0" },
    "contentManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "path", "sha256", "bytes" ],
        "properties": {
          "path": {
            "enum": [
              "existing-workspace.createUiDefinition.json",
              "existing-workspace.json",
              "greenfield.createUiDefinition.json",
              "greenfield.json"
            ]
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
