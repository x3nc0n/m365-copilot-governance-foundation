_Im_AgentEvent(starttime=starttime, endtime=endtime)
| project
    TimeGenerated,
    EventStartTime,
    EventEndTime,
    IngestionTime = ingestion_time(),
    EventUid,
    EventOriginalUid,
    EventType,
    EventOriginalType,
    EventResult,
    EventResultDetails,
    ActorUsername,
    ActorUserId,
    ActingAppId,
    ActingAppName,
    SrcAgentId,
    SrcAgentName,
    TargetAgentId,
    TargetAgentName,
    PlatformTargetAgentId,
    PlatformTargetAgentName,
    ModelProviderName,
    ModelName,
    ToolId,
    ToolName,
    EventSessionId,
    EventRequestId,
    EventResponseId,
    EventProduct,
    EventVendor,
    EventSchema,
    EventSchemaVersion
| extend
    GovernanceFunction = "M365Gov_AiActivity",
    AuthoritativeControlOwner = "Source AI platform; Microsoft Sentinel ASIM provides normalization",
    NativePortalRoute = "https://security.microsoft.com/"
