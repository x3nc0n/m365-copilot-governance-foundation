let queryStartTime = iff(isnull(starttime), ago(14d), starttime);
let queryEndTime = iff(isnull(endtime), now(), endtime);
_Im_Authentication(starttime=queryStartTime, endtime=queryEndTime)
| project
    TimeGenerated,
    EventStartTime,
    EventEndTime,
    IngestionTime = ingestion_time(),
    EventUid,
    EventType,
    EventResult,
    EventResultDetails,
    EventOriginalResultDetails,
    ActorUsername,
    ActorUserId,
    TargetUsername,
    TargetUserId,
    SrcIpAddr,
    SrcGeoCountry,
    TargetAppName,
    TargetAppId,
    LogonMethod,
    EventProduct,
    EventVendor,
    EventSchema,
    EventSchemaVersion
| extend
    GovernanceFunction = "M365Gov_AuthenticationEvents",
    AuthoritativeControlOwner = "Microsoft Entra ID and the source authentication provider",
    NativePortalRoute = "https://entra.microsoft.com/#view/Microsoft_AAD_UsersAndTenants/UserManagementMenuBlade/~/SignIns"
